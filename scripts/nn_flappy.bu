// === BU NN Flappy ===
// Supervised imitation learning with nn.Network() for a Flappy-style game.

import math;
import fs;
import nn;

// --- Window ---
var VIEW_W = 1400;
var VIEW_H = 840;

// --- Layout ---
var FIELD_X = 24;
var FIELD_Y = 70;
var FIELD_W = 920;
var FIELD_H = 740;

var PANEL_X = 970;
var PANEL_W = VIEW_W - PANEL_X - 18;

// --- Keys ---
var KEY_ESCAPE = 256;
var KEY_SPACE = 32;
var KEY_T = 84;
var KEY_R = 82;
var KEY_H = 72;
var KEY_G = 71;
var KEY_L = 76;
var KEY_O = 79;

// --- Game physics ---
var BIRD_X = FIELD_X + 230;
var BIRD_R = 16;
var CEIL_Y = FIELD_Y + 18;
var FLOOR_Y = FIELD_Y + FIELD_H - 20;

var GRAVITY = 980.0;
var FLAP_VY = -330.0;
var MAX_FALL = 520.0;
var FLAP_COOLDOWN = 0.085;

var PIPE_W = 88;
var PIPE_GAP_H = 190;
var PIPE_SPEED = 220.0;
var PIPE_SPAWN_TIME = 1.35;
var SIM_DT = 1.0 / 60.0;

// --- Model ---
var MODEL = nil;
var MODEL_READY = false;
var MODEL_FILE = "nn_flappy.bunn";
var NN_IN = 6;
var NN_OUT = 2; // stay, flap
var HUMAN_MODE = false;

var FLAP_TRIGGER = 0.54;

// --- Training ---
var TRAIN_SAMPLES = 3200;
var TRAIN_EPOCHS = 90;
var TRAIN_BATCH = 32;
var EVAL_EPISODES = 6;
var TRAIN_X = [];
var TRAIN_Y = [];
var TRAINING_ACTIVE = false;
var CURRENT_EPOCH = 0;
var LAST_EVAL_SCORE = 0.0;
var BEST_EVAL_SCORE = 0.0;
var TRAIN_RESET_PENDING = false;

// --- Live state ---
var LIVE_BIRD_Y = 0.0;
var LIVE_BIRD_VY = 0.0;
var LIVE_FLAP_CD = 0.0;
var LIVE_SCORE = 0;
var LIVE_BEST_SCORE = 0;
var LIVE_DEAD = false;
var LIVE_DEAD_TIMER = 0.0;
var LIVE_SPAWN_TIMER = 0.0;
var LIVE_NEXT_X = 0.0;
var LIVE_NEXT_GAP = 0.0;
var LIVE_LAST_ACTION = 0;

// --- Viz ---
var STATUS_TEXT = "";
var STATUS_TIMER = 0.0;
var LAST_IN = [];
var LAST_OUT = [];
var STARS = [];
var LIVE_PIPES = [];

struct Star
{
    var x;
    var y;
    var brightness;
}

struct Pipe
{
    var x;
    var gap_y;
    var passed;
}

// ============================================
// Helpers
// ============================================

def clampf(v, a, b)
{
    if (v < a) return a;
    if (v > b) return b;
    return v;
}

def safe_ratio(n, d)
{
    if (!d) return 0.0;
    return n / d;
}

def randf(a, b) { return math.rand(a, b); }

def sane_prob(v)
{
    if (v != v) return 0.0;
    if (v < 0.0) return 0.0;
    if (v > 1.0) return 1.0;
    return v;
}

def set_status(msg)
{
    STATUS_TEXT = msg;
    STATUS_TIMER = 3.0;
}

def random_gap_y()
{
    var min_y = CEIL_Y + PIPE_GAP_H * 0.5 + 24;
    var max_y = FLOOR_Y - PIPE_GAP_H * 0.5 - 24;
    return randf(min_y, max_y);
}

def generate_stars()
{
    STARS = [];
    for (var i = 0; i < 90; i = i + 1)
    {
        var s = Star();
        s.x = randf(FIELD_X, FIELD_X + FIELD_W);
        s.y = randf(FIELD_Y, FIELD_Y + FIELD_H * 0.6);
        s.brightness = math.irand(70, 230);
        STARS.push(s);
    }
}

def make_input(bird_y, bird_vy, next_x, next_gap)
{
    return [
        safe_ratio(bird_y - FIELD_Y, FIELD_H),
        safe_ratio(bird_vy, MAX_FALL),
        safe_ratio(next_x - BIRD_X, FIELD_W),
        safe_ratio(next_gap - FIELD_Y, FIELD_H),
        safe_ratio(bird_y - next_gap, PIPE_GAP_H * 0.5),
        safe_ratio(PIPE_SPEED, 320.0)
    ];
}

def teacher_output(bird_y, bird_vy, next_x, next_gap)
{
    var flap = 0.0;
    var dy = bird_y - next_gap;
    var dist_x = next_x - BIRD_X;

    if (bird_y > FLOOR_Y - 90) flap = 1.0;
    if (dy > 18 && bird_vy > -120) flap = 1.0;
    if (dy > 8 && dist_x < 180 && bird_vy > -40) flap = 1.0;
    if (dy > -4 && dist_x < 120 && bird_vy > 70) flap = 1.0;
    if (dy > -14 && dist_x < 72 && bird_vy > 130) flap = 1.0;
    if (bird_y < CEIL_Y + 45 && bird_vy < 0) flap = 0.0;

    if (flap >= 0.5) return [0.0, 1.0];
    return [1.0, 0.0];
}

def decide_flap(pred)
{
    LAST_OUT = pred;
    if (len(pred) < 2) return false;
    var stay = sane_prob(pred[0]);
    var flap = sane_prob(pred[1]);
    LAST_OUT = [stay, flap];
    return flap > FLAP_TRIGGER && flap > stay;
}

def predict_flap(inp)
{
    if (!MODEL_READY || !MODEL) return false;
    var pred = MODEL.predict(inp);
    if (len(pred) < 2) return false;
    var stay = sane_prob(pred[0]);
    var flap = sane_prob(pred[1]);
    return flap > FLAP_TRIGGER && flap > stay;
}

def build_model()
{
    MODEL = Network();
    MODEL.add(NN_IN, 18, "relu");
    MODEL.add(18, 12, "relu");
    MODEL.add(12, NN_OUT, "sigmoid");
    MODEL.compile("adam", "mse", 0.003);
    MODEL_READY = true;
}

def prepare_training_data()
{
    TRAIN_X = [];
    TRAIN_Y = [];
    for (var i = 0; i < TRAIN_SAMPLES; i = i + 1)
    {
        var bird_y = randf(CEIL_Y + 10, FLOOR_Y - 10);
        var bird_vy = randf(-380, MAX_FALL);
        var next_x = randf(BIRD_X + 20, FIELD_X + FIELD_W + 120);
        var next_gap = random_gap_y();

        if (math.irand(0, 100) < 40)
        {
            next_x = randf(BIRD_X + 10, BIRD_X + 160);
            bird_y = next_gap + randf(-120, 120);
            bird_vy = randf(-80, MAX_FALL);
        }

        TRAIN_X.push(make_input(bird_y, bird_vy, next_x, next_gap));
        TRAIN_Y.push(teacher_output(bird_y, bird_vy, next_x, next_gap));
    }
}

def eval_episode()
{
    var bird_y = FIELD_Y + FIELD_H * 0.5;
    var bird_vy = 0.0;
    var flap_cd = 0.0;
    var score = 0;
    var spawn_timer = 0.30;
    var pipes = [];
    var next_x = FIELD_X + FIELD_W + 120;
    var next_gap = FIELD_Y + FIELD_H * 0.5;
    var steps = 0;

    while (steps < 2400)
    {
        spawn_timer -= SIM_DT;
        if (spawn_timer <= 0)
        {
            spawn_timer = PIPE_SPAWN_TIME;
            var new_pipe = Pipe();
            new_pipe.x = FIELD_X + FIELD_W + 90;
            new_pipe.gap_y = random_gap_y();
            new_pipe.passed = 0;
            pipes.push(new_pipe);
        }

        var next_pipes = [];
        for (var i = 0; i < len(pipes); i = i + 1)
        {
            var p = pipes[i];
            p.x -= PIPE_SPEED * SIM_DT;
            if (p.x + PIPE_W >= FIELD_X - 40) next_pipes.push(p);
        }
        pipes = next_pipes;

        next_x = FIELD_X + FIELD_W + 120;
        next_gap = FIELD_Y + FIELD_H * 0.5;
        for (var j = 0; j < len(pipes); j = j + 1)
        {
            var fp = pipes[j];
            if (fp.x + PIPE_W >= BIRD_X - 6 && fp.x < next_x)
            {
                next_x = fp.x;
                next_gap = fp.gap_y;
            }
        }

        var flap = predict_flap(make_input(bird_y, bird_vy, next_x, next_gap));
        if (flap && flap_cd <= 0)
        {
            bird_vy = FLAP_VY;
            flap_cd = FLAP_COOLDOWN;
        }

        if (flap_cd > 0) flap_cd -= SIM_DT;
        if (flap_cd < 0) flap_cd = 0;

        bird_vy += GRAVITY * SIM_DT;
        bird_vy = clampf(bird_vy, -900.0, MAX_FALL);
        bird_y += bird_vy * SIM_DT;

        if (bird_y - BIRD_R < CEIL_Y || bird_y + BIRD_R > FLOOR_Y) return score;

        for (var k = 0; k < len(pipes); k = k + 1)
        {
            var cp = pipes[k];
            if (!cp.passed && cp.x + PIPE_W < BIRD_X)
            {
                cp.passed = 1;
                score += 1;
            }

            if (BIRD_X + BIRD_R > cp.x && BIRD_X - BIRD_R < cp.x + PIPE_W)
            {
                var gap_top = cp.gap_y - PIPE_GAP_H * 0.5;
                var gap_bottom = cp.gap_y + PIPE_GAP_H * 0.5;
                if (bird_y - BIRD_R < gap_top || bird_y + BIRD_R > gap_bottom)
                    return score;
            }
        }

        steps += 1;
    }

    return score;
}

def evaluate_model()
{
    if (!MODEL_READY || !MODEL) return 0.0;

    var total = 0.0;
    for (var i = 0; i < EVAL_EPISODES; i = i + 1)
        total += eval_episode();
    return safe_ratio(total, EVAL_EPISODES);
}

def start_training()
{
    build_model();
    prepare_training_data();
    TRAINING_ACTIVE = true;
    CURRENT_EPOCH = 0;
    LAST_EVAL_SCORE = 0.0;
    BEST_EVAL_SCORE = 0.0;
    TRAIN_RESET_PENDING = true;
    set_status("Training started");
}

def train_one_epoch()
{
    if (!TRAINING_ACTIVE) return;
    if (CURRENT_EPOCH >= TRAIN_EPOCHS)
    {
        TRAINING_ACTIVE = false;
        set_status(format("Training finished. best eval={}", int(BEST_EVAL_SCORE * 100) / 100.0));
        return;
    }

    MODEL.fit(TRAIN_X, TRAIN_Y, 1, TRAIN_BATCH);
    MODEL_READY = true;
    CURRENT_EPOCH += 1;
    LAST_EVAL_SCORE = evaluate_model();
    if (LAST_EVAL_SCORE > BEST_EVAL_SCORE) BEST_EVAL_SCORE = LAST_EVAL_SCORE;

    if (CURRENT_EPOCH >= TRAIN_EPOCHS)
    {
        TRAINING_ACTIVE = false;
        set_status(format("Epoch {} done. best eval={}", CURRENT_EPOCH, int(BEST_EVAL_SCORE * 100) / 100.0));
    }
    else
    {
        set_status(format("Epoch {}/{}  avg score={}", CURRENT_EPOCH, TRAIN_EPOCHS, int(LAST_EVAL_SCORE * 100) / 100.0));
    }
}

def save_model()
{
    if (!MODEL_READY || !MODEL) { set_status("No model"); return; }
    if (MODEL.save(MODEL_FILE)) set_status("Model saved");
    else set_status("Save failed");
}

def load_model()
{
    MODEL = Network();
    if (MODEL.load(MODEL_FILE))
    {
        MODEL_READY = true;
        TRAINING_ACTIVE = false;
        set_status("Model loaded");
        return true;
    }
    MODEL_READY = false;
    set_status("Load failed");
    return false;
}

// ============================================
// Live game
// ============================================

def live_spawn_pipe()
{
    var p = Pipe();
    p.x = FIELD_X + FIELD_W + 90;
    p.gap_y = random_gap_y();
    p.passed = 0;
    LIVE_PIPES.push(p);
}

def live_find_next_pipe()
{
    LIVE_NEXT_X = FIELD_X + FIELD_W + 120;
    LIVE_NEXT_GAP = FIELD_Y + FIELD_H * 0.5;
    for (var i = 0; i < len(LIVE_PIPES); i = i + 1)
    {
        var p = LIVE_PIPES[i];
        var front = p.x + PIPE_W;
        if (front >= BIRD_X - 6 && p.x < LIVE_NEXT_X)
        {
            LIVE_NEXT_X = p.x;
            LIVE_NEXT_GAP = p.gap_y;
        }
    }
}

def live_reset()
{
    LIVE_BIRD_Y = FIELD_Y + FIELD_H * 0.5;
    LIVE_BIRD_VY = 0.0;
    LIVE_FLAP_CD = 0.0;
    LIVE_SCORE = 0;
    LIVE_LAST_ACTION = 0;
    LIVE_DEAD = false;
    LIVE_DEAD_TIMER = 0.0;
    LIVE_SPAWN_TIMER = 0.30;
    LIVE_NEXT_X = FIELD_X + FIELD_W + 120;
    LIVE_NEXT_GAP = FIELD_Y + FIELD_H * 0.5;
    LIVE_PIPES = [];
}

def live_update_pipes(dt)
{
    LIVE_SPAWN_TIMER -= dt;
    if (LIVE_SPAWN_TIMER <= 0)
    {
        LIVE_SPAWN_TIMER = PIPE_SPAWN_TIME;
        live_spawn_pipe();
    }

    var next_pipes = [];
    for (var i = 0; i < len(LIVE_PIPES); i = i + 1)
    {
        var p = LIVE_PIPES[i];
        p.x -= PIPE_SPEED * dt;
        if (p.x + PIPE_W >= FIELD_X - 40) next_pipes.push(p);
    }
    LIVE_PIPES = next_pipes;
}

def live_check_collision_and_score()
{
    var dead = false;
    if (LIVE_BIRD_Y - BIRD_R < CEIL_Y) dead = true;
    if (LIVE_BIRD_Y + BIRD_R > FLOOR_Y) dead = true;

    for (var i = 0; i < len(LIVE_PIPES); i = i + 1)
    {
        var p = LIVE_PIPES[i];
        if (!p.passed && p.x + PIPE_W < BIRD_X)
        {
            p.passed = 1;
            LIVE_SCORE += 1;
            if (LIVE_SCORE > LIVE_BEST_SCORE) LIVE_BEST_SCORE = LIVE_SCORE;
        }

        if (!dead && BIRD_X + BIRD_R > p.x && BIRD_X - BIRD_R < p.x + PIPE_W)
        {
            var gap_top = p.gap_y - PIPE_GAP_H * 0.5;
            var gap_bottom = p.gap_y + PIPE_GAP_H * 0.5;
            if (LIVE_BIRD_Y - BIRD_R < gap_top || LIVE_BIRD_Y + BIRD_R > gap_bottom)
                dead = true;
        }
    }

    return dead;
}

def update_live(dt)
{
    if (LIVE_DEAD)
    {
        LIVE_DEAD_TIMER -= dt;
        if (LIVE_DEAD_TIMER <= 0) live_reset();
        return;
    }

    live_update_pipes(dt);
    live_find_next_pipe();

    var flap = false;
    if (HUMAN_MODE)
    {
        if (key_down(KEY_SPACE)) flap = true;
    }
    else if (MODEL_READY)
    {
        LAST_IN = make_input(LIVE_BIRD_Y, LIVE_BIRD_VY, LIVE_NEXT_X, LIVE_NEXT_GAP);
        flap = decide_flap(MODEL.predict(LAST_IN));
    }

    LIVE_LAST_ACTION = 0;
    if (flap && LIVE_FLAP_CD <= 0)
    {
        LIVE_BIRD_VY = FLAP_VY;
        LIVE_FLAP_CD = FLAP_COOLDOWN;
        LIVE_LAST_ACTION = 1;
    }

    if (LIVE_FLAP_CD > 0) LIVE_FLAP_CD -= dt;
    if (LIVE_FLAP_CD < 0) LIVE_FLAP_CD = 0;

    LIVE_BIRD_VY += GRAVITY * dt;
    LIVE_BIRD_VY = clampf(LIVE_BIRD_VY, -900.0, MAX_FALL);
    LIVE_BIRD_Y += LIVE_BIRD_VY * dt;

    if (live_check_collision_and_score())
    {
        LIVE_DEAD = true;
        LIVE_DEAD_TIMER = 0.85;
        if (!TRAINING_ACTIVE) set_status("Crash");
    }
}

// ============================================
// Draw
// ============================================

def draw_field()
{
    set_color(8, 14, 24);
    draw_rectangle(0, 0, VIEW_W, VIEW_H, true);

    set_color(26, 44, 70);
    draw_rectangle(FIELD_X, FIELD_Y, FIELD_W, FIELD_H, true);
    set_color(96, 140, 185);
    draw_rectangle(FIELD_X, FIELD_Y, FIELD_W, FIELD_H, false);

    for (var i = 0; i < len(STARS); i = i + 1)
    {
        var s = STARS[i];
        set_color(s.brightness, s.brightness, s.brightness);
        draw_circle(s.x, s.y, 1, true);
    }

    set_color(20, 28, 44);
    draw_rectangle(FIELD_X, FIELD_Y, FIELD_W, CEIL_Y - FIELD_Y, true);
    draw_rectangle(FIELD_X, FLOOR_Y, FIELD_W, FIELD_Y + FIELD_H - FLOOR_Y, true);

    for (var i = 0; i < len(LIVE_PIPES); i = i + 1)
    {
        var p = LIVE_PIPES[i];
        var top_h = p.gap_y - PIPE_GAP_H * 0.5 - CEIL_Y;
        var bottom_y = p.gap_y + PIPE_GAP_H * 0.5;
        var bottom_h = FLOOR_Y - bottom_y;

        set_color(65, 185, 95);
        if (top_h > 0) draw_rectangle(p.x, CEIL_Y, PIPE_W, top_h, true);
        if (bottom_h > 0) draw_rectangle(p.x, bottom_y, PIPE_W, bottom_h, true);

        set_color(120, 230, 150);
        if (top_h > 0) draw_rectangle(p.x, CEIL_Y, PIPE_W, top_h, false);
        if (bottom_h > 0) draw_rectangle(p.x, bottom_y, PIPE_W, bottom_h, false);
    }

    if (LIVE_DEAD) set_color(255, 140, 120);
    else set_color(255, 220, 110);
    draw_circle(BIRD_X, LIVE_BIRD_Y, BIRD_R, true);
    set_color(22, 22, 30);
    draw_circle(BIRD_X + 6, LIVE_BIRD_Y - 4, 3, true);

    set_color(220, 240, 255);
    draw_text("BU NN Flappy", FIELD_X, 16, 36);
    set_color(160, 195, 225);
    draw_text("Imitation learning with nn.Network()", FIELD_X, 50, 20);

    set_color(255, 240, 175);
    draw_text(format("Score: {}", LIVE_SCORE), FIELD_X + 300, 24, 30);
    set_color(175, 210, 240);
    draw_text(format("Best: {}", LIVE_BEST_SCORE), FIELD_X + 490, 28, 24);
    if (LIVE_DEAD)
    {
        set_color(255, 170, 150);
        draw_text("CRASH!", FIELD_X + 660, 28, 26);
    }
}

def draw_panel()
{
    set_color(18, 26, 38);
    draw_rectangle(PANEL_X, FIELD_Y, PANEL_W, FIELD_H, true);
    set_color(92, 118, 150);
    draw_rectangle(PANEL_X, FIELD_Y, PANEL_W, FIELD_H, false);

    set_color(220, 238, 255);
    draw_text("NN Stats", PANEL_X + 16, FIELD_Y + 14, 30);

    set_color(198, 220, 245);
    draw_text(format("Model ready: {}", MODEL_READY), PANEL_X + 16, FIELD_Y + 70, 20);
    draw_text(format("Training: {}", TRAINING_ACTIVE), PANEL_X + 16, FIELD_Y + 94, 20);
    draw_text(format("Human: {}", HUMAN_MODE), PANEL_X + 16, FIELD_Y + 118, 20);
    draw_text(format("File: {}", MODEL_FILE), PANEL_X + 16, FIELD_Y + 142, 16);
    draw_text(format("Samples: {}", TRAIN_SAMPLES), PANEL_X + 16, FIELD_Y + 168, 18);
    draw_text(format("Epoch: {}/{}", CURRENT_EPOCH, TRAIN_EPOCHS), PANEL_X + 16, FIELD_Y + 190, 18);
    draw_text(format("Batch: {}", TRAIN_BATCH), PANEL_X + 220, FIELD_Y + 190, 18);
    draw_text(format("Last eval: {}", int(LAST_EVAL_SCORE * 100) / 100.0), PANEL_X + 16, FIELD_Y + 214, 18);
    draw_text(format("Best eval: {}", int(BEST_EVAL_SCORE * 100) / 100.0), PANEL_X + 16, FIELD_Y + 236, 18);

    set_color(150, 180, 210);
    draw_text("Controls:", PANEL_X + 16, FIELD_Y + 276, 18);
    draw_text("T: start/stop epoch training", PANEL_X + 16, FIELD_Y + 298, 16);
    draw_text("G/L: save/load .bunn", PANEL_X + 16, FIELD_Y + 316, 16);
    draw_text("H: human mode", PANEL_X + 16, FIELD_Y + 334, 16);
    draw_text("R: reset world", PANEL_X + 16, FIELD_Y + 352, 16);
    draw_text("O: fresh stars", PANEL_X + 16, FIELD_Y + 370, 16);
    draw_text("SPACE: flap in human mode", PANEL_X + 16, FIELD_Y + 388, 16);

    set_color(205, 224, 245);
    draw_text("Last Inputs", PANEL_X + 16, FIELD_Y + 432, 20);
    var labels_in = ["birdY", "birdVy", "pipeDx", "gapY", "dyGap", "speed"];
    for (var i = 0; i < len(labels_in); i = i + 1)
    {
        var v = 0.0;
        if (i < len(LAST_IN)) v = LAST_IN[i];
        draw_text(format("{}: {}", labels_in[i], int(v * 100) / 100.0), PANEL_X + 16, FIELD_Y + 458 + i * 20, 13);
    }

    set_color(205, 224, 245);
    draw_text("Last Outputs", PANEL_X + 16, FIELD_Y + 610, 20);
    var labels_out = ["STAY", "FLAP"];
    for (var j = 0; j < 2; j = j + 1)
    {
        var ov = 0.0;
        if (j < len(LAST_OUT)) ov = LAST_OUT[j];
        ov = sane_prob(ov);
        var by = FIELD_Y + 640 + j * 28;
        var bw = int(clampf(ov, 0.0, 1.0) * 190);
        set_color(80, 95, 120);
        draw_rectangle(PANEL_X + 110, by, 190, 18, true);
        if (j == 0) set_color(145, 200, 255);
        else set_color(255, 170, 120);
        draw_rectangle(PANEL_X + 110, by, bw, 18, true);
        set_color(190, 210, 235);
        draw_text(labels_out[j], PANEL_X + 16, by + 1, 14);
        draw_text(format("{}%", int(ov * 100)), PANEL_X + 306, by + 1, 14);
    }

    set_color(255, 230, 150);
    if (LIVE_LAST_ACTION == 1) draw_text("Decision: FLAP", PANEL_X + 16, FIELD_Y + 700, 18);
    else draw_text("Decision: STAY", PANEL_X + 16, FIELD_Y + 700, 18);

    if (STATUS_TIMER > 0)
    {
        set_color(255, 230, 160);
        draw_text(STATUS_TEXT, PANEL_X + 16, FIELD_Y + FIELD_H - 12, 16);
    }
}

// ============================================
// Main
// ============================================

set_window_size(VIEW_W, VIEW_H);
set_window_title("BU NN Flappy");
set_design_resolution(VIEW_W, VIEW_H);
set_virtual_screen_enabled(true);

generate_stars();
live_reset();
set_status("Press T to start epoch training");

loop
{
    var dt = delta();
    if (dt <= 0.0) dt = SIM_DT;
    if (dt > 0.05) dt = 0.05;

    if (key_pressed(KEY_ESCAPE)) close_window();
    if (key_pressed(KEY_T))
    {
        if (TRAINING_ACTIVE)
        {
            TRAINING_ACTIVE = false;
            set_status("Training paused");
        }
        else start_training();
    }
    if (key_pressed(KEY_G)) save_model();
    if (key_pressed(KEY_L)) load_model();
    if (key_pressed(KEY_O)) { generate_stars(); set_status("Stars regenerated"); }
    if (key_pressed(KEY_R)) { live_reset(); set_status("World reset"); }
    if (key_pressed(KEY_H))
    {
        HUMAN_MODE = !HUMAN_MODE;
        if (HUMAN_MODE) set_status("HUMAN mode");
        else set_status("AI mode");
        live_reset();
    }

    train_one_epoch();
    if (TRAIN_RESET_PENDING)
    {
        live_reset();
        TRAIN_RESET_PENDING = false;
    }
    update_live(dt);

    if (STATUS_TIMER > 0)
    {
        STATUS_TIMER -= dt;
        if (STATUS_TIMER < 0) STATUS_TIMER = 0;
    }

    set_draw_screen(true);
    draw_field();
    draw_panel();
    set_draw_screen(false);
    frame;
}
