// Cozy Winter Jam 2026 - Reflection
// Micro-scope jam game built for web/android + desktop.

import math;

var VIEW_W = 1280;
var VIEW_H = 720;

var KEY_LEFT = 263;
var KEY_RIGHT = 262;
var KEY_UP = 265;
var KEY_DOWN = 264;
var KEY_ENTER = 257;
var KEY_SPACE = 32;
var KEY_ESCAPE = 256;
var KEY_P = 80;
var KEY_R = 82;

var STATE_MENU = 0;
var STATE_PLAY = 1;
var STATE_PAUSE = 2;
var STATE_WIN = 3;

var GAME_STATE = STATE_MENU;
var APP_RUNNING = true;

var WATER_Y = 420;

var POINTER_X = 0.0;
var POINTER_Y = 0.0;
var POINTER_DOWN = false;
var POINTER_PRESSED = false;
var POINTER_WAS_DOWN = false;

var MENU_INDEX = 0;
var PAUSE_INDEX = 0;
var WIN_INDEX = 0;
var SHOW_HELP = false;

var MENU_OPTIONS = ["Start Cozy Run", "How To Play", "Exit"];
var PAUSE_OPTIONS = ["Resume", "Restart Level", "Menu"];
var WIN_OPTIONS = ["Play Again", "Back To Menu"];

var CURRENT_LEVEL = 1;
var TOTAL_LEVELS = 8;
var SESSION_START_TIME = 0.0;
var SESSION_SECONDS = 0.0;

var TARGETS = [];   // [x, y]
var LANTERNS = [];  // [x, y]

var LEVEL_SOLVED = false;
var LEVEL_SOLVE_TIMER = 0.0;

var TARGET_RADIUS = 8;
var LANTERN_RADIUS = 12;
var REFLECT_TOLERANCE = 24;
var MAX_EXTRA_LANTERNS = 3;

var BTN_PAUSE_X = VIEW_W - 142;
var BTN_PAUSE_Y = 18;
var BTN_PAUSE_W = 108;
var BTN_PAUSE_H = 40;

var SNOW = []; // [x, y, speed, drift, size]

// ----------------------------------------------------------
// Utility
// ----------------------------------------------------------
def point_in_rect(px, py, rx, ry, rw, rh)
{
    if (px < rx) return false;
    if (py < ry) return false;
    if (px > rx + rw) return false;
    if (py > ry + rh) return false;
    return true;
}

def dist2(x1, y1, x2, y2)
{
    var dx = x2 - x1;
    var dy = y2 - y1;
    return dx * dx + dy * dy;
}

def reflection_y(_y)
{
    return WATER_Y + (WATER_Y - _y);
}

def update_pointer()
{
    var touch_down = (touch_count() > 0);

    if (touch_down)
    {
        POINTER_X = get_touch_screen_x(0);
        POINTER_Y = get_touch_screen_y(0);
    }
    else
    {
        POINTER_X = get_mouse_x();
        POINTER_Y = get_mouse_y();
    }

    POINTER_DOWN = (touch_down || mouse_down(0));
    POINTER_PRESSED = (POINTER_DOWN && !POINTER_WAS_DOWN);
    POINTER_WAS_DOWN = POINTER_DOWN;
}

// ----------------------------------------------------------
// Cozy background
// ----------------------------------------------------------
def seed_snow()
{
    SNOW = [];

    var i = 0;
    while (i < 130)
    {
        var x = math.irand(0, VIEW_W);
        var y = math.irand(0, VIEW_H);
        var speed = math.irand(16, 62);
        var drift = math.irand(-18, 18) / 10.0;
        var size = math.irand(1, 3);
        SNOW.push([x, y, speed, drift, size]);
        i += 1;
    }
}

def update_snow(_dt)
{
    var i = 0;
    while (i < len(SNOW))
    {
        var p = SNOW[i];

        p[1] = p[1] + p[2] * _dt;
        p[0] = p[0] + p[3] * _dt;

        if (p[1] > VIEW_H + 8)
        {
            p[1] = -10;
            p[0] = math.irand(0, VIEW_W);
            p[2] = math.irand(16, 62);
            p[3] = math.irand(-18, 18) / 10.0;
            p[4] = math.irand(1, 3);
        }

        if (p[0] < -8) p[0] = VIEW_W + 6;
        if (p[0] > VIEW_W + 8) p[0] = -6;

        SNOW[i] = p;
        i += 1;
    }
}

def draw_background()
{
    // sky gradient stripes
    set_color(10, 17, 32);
    draw_rectangle(0, 0, VIEW_W, 140, true);
    set_color(14, 24, 43);
    draw_rectangle(0, 140, VIEW_W, 120, true);
    set_color(20, 33, 56);
    draw_rectangle(0, 260, VIEW_W, WATER_Y - 260, true);

    // moon
    set_color(230, 238, 255);
    draw_circle(1030, 108, 50, true);
    set_color(200, 214, 240);
    draw_circle(1016, 98, 50, true);

    // horizon glow
    set_color(125, 150, 194);
    draw_rectangle(0, WATER_Y - 3, VIEW_W, 6, true);

    // water
    set_color(16, 34, 56);
    draw_rectangle(0, WATER_Y, VIEW_W, VIEW_H - WATER_Y, true);

    // subtle moving ripples
    var t = time();
    var i = 0;
    while (i < 16)
    {
        var yy = WATER_Y + 18 + i * 17;
        var wobble = sin(t * 1.5 + i * 0.7) * 14;
        var x0 = 120 + wobble;
        var x1 = VIEW_W - 120 + wobble;

        if ((i % 2) == 0) set_color(36, 60, 92);
        else set_color(30, 52, 80);

        draw_line(x0, yy, x1, yy);
        i += 1;
    }
}

def draw_snow()
{
    var i = 0;
    while (i < len(SNOW))
    {
        var p = SNOW[i];

        if (p[4] == 1)
        {
            set_alpha(145);
            set_color(220, 230, 245);
        }
        elif (p[4] == 2)
        {
            set_alpha(185);
            set_color(230, 236, 250);
        }
        else
        {
            set_alpha(220);
            set_color(240, 246, 255);
        }

        draw_circle(p[0], p[1], p[4], true);
        i += 1;
    }

    set_alpha(255);
}

// ----------------------------------------------------------
// Level + matching logic
// ----------------------------------------------------------
def clear_lantern_at(_index)
{
    var keep = [];
    var i = 0;
    while (i < len(LANTERNS))
    {
        if (i != _index)
        {
            keep.push(LANTERNS[i]);
        }
        i += 1;
    }
    LANTERNS = keep;
}

def build_level(_level)
{
    TARGETS = [];
    LANTERNS = [];

    LEVEL_SOLVED = false;
    LEVEL_SOLVE_TIMER = 0.0;

    var target_count = _level + 1;
    if (target_count > 6) target_count = 6;

    var created = 0;
    var guard = 0;
    while (created < target_count && guard < 1000)
    {
        guard += 1;

        var x = math.irand(220, VIEW_W - 220);
        var y = math.irand(110, WATER_Y - 145);

        var ok = true;
        var i = 0;
        while (i < len(TARGETS))
        {
            var q = TARGETS[i];
            if (dist2(x, y, q[0], q[1]) < (95 * 95))
            {
                ok = false;
                break;
            }
            i += 1;
        }

        if (ok)
        {
            TARGETS.push([x, y]);
            created += 1;
        }
    }

    // Fallback in rare packing failure
    while (len(TARGETS) < target_count)
    {
        var idx = len(TARGETS);
        var fx = 250 + idx * 150;
        var fy = 140 + (idx % 3) * 55;
        TARGETS.push([fx, fy]);
    }
}

def start_session()
{
    CURRENT_LEVEL = 1;
    SESSION_START_TIME = time();
    SESSION_SECONDS = 0.0;
    build_level(CURRENT_LEVEL);
    GAME_STATE = STATE_PLAY;
}

def restart_level()
{
    build_level(CURRENT_LEVEL);
}

def target_match_index(_target_index)
{
    var t = TARGETS[_target_index];
    var rx = t[0];
    var ry = reflection_y(t[1]);
    var tol2 = REFLECT_TOLERANCE * REFLECT_TOLERANCE;

    var i = 0;
    while (i < len(LANTERNS))
    {
        var l = LANTERNS[i];
        if (dist2(rx, ry, l[0], l[1]) <= tol2)
        {
            return i;
        }
        i += 1;
    }

    return -1;
}

def level_is_solved()
{
    var i = 0;
    while (i < len(TARGETS))
    {
        if (target_match_index(i) < 0)
        {
            return false;
        }
        i += 1;
    }

    return true;
}

// ----------------------------------------------------------
// UI helpers
// ----------------------------------------------------------
def draw_button(_x, _y, _w, _h, _text, _hot, _selected)
{
    if (_selected)
    {
        set_color(76, 112, 170);
    }
    elif (_hot)
    {
        set_color(58, 88, 136);
    }
    else
    {
        set_color(38, 58, 92);
    }
    draw_rectangle(_x, _y, _w, _h, true);

    if (_selected || _hot) set_color(205, 228, 255);
    else set_color(145, 172, 210);
    draw_rectangle(_x, _y, _w, _h, false);

    set_color(237, 244, 255);
    draw_text(_text, _x + 20, _y + 11, 24);
}

// ----------------------------------------------------------
// Game state updates
// ----------------------------------------------------------
def update_menu()
{
    if (SHOW_HELP)
    {
        if (key_pressed(KEY_ESCAPE) || key_pressed(KEY_ENTER) || POINTER_PRESSED)
        {
            SHOW_HELP = false;
        }
        return;
    }

    if (key_pressed(KEY_UP))
    {
        MENU_INDEX -= 1;
        if (MENU_INDEX < 0) MENU_INDEX = len(MENU_OPTIONS) - 1;
    }

    if (key_pressed(KEY_DOWN))
    {
        MENU_INDEX += 1;
        if (MENU_INDEX >= len(MENU_OPTIONS)) MENU_INDEX = 0;
    }

    var bx = VIEW_W / 2 - 210;
    var by0 = 320;
    var bw = 420;
    var bh = 50;
    var gap = 14;

    var i = 0;
    while (i < len(MENU_OPTIONS))
    {
        var by = by0 + i * (bh + gap);
        if (point_in_rect(POINTER_X, POINTER_Y, bx, by, bw, bh))
        {
            MENU_INDEX = i;
            if (POINTER_PRESSED)
            {
                if (i == 0)
                {
                    start_session();
                }
                elif (i == 1)
                {
                    SHOW_HELP = true;
                }
                else
                {
                    APP_RUNNING = false;
                }
                return;
            }
        }
        i += 1;
    }

    if (key_pressed(KEY_ENTER) || key_pressed(KEY_SPACE))
    {
        if (MENU_INDEX == 0)
        {
            start_session();
        }
        elif (MENU_INDEX == 1)
        {
            SHOW_HELP = true;
        }
        else
        {
            APP_RUNNING = false;
        }
    }
}

def update_play(_dt)
{
    if (POINTER_PRESSED && point_in_rect(POINTER_X, POINTER_Y, BTN_PAUSE_X, BTN_PAUSE_Y, BTN_PAUSE_W, BTN_PAUSE_H))
    {
        PAUSE_INDEX = 0;
        GAME_STATE = STATE_PAUSE;
        return;
    }

    if (key_pressed(KEY_ESCAPE) || key_pressed(KEY_P) || key_pressed(KEY_SPACE))
    {
        PAUSE_INDEX = 0;
        GAME_STATE = STATE_PAUSE;
        return;
    }

    if (key_pressed(KEY_R))
    {
        restart_level();
        return;
    }

    if (POINTER_PRESSED)
    {
        if (POINTER_Y > WATER_Y + 20)
        {
            var near_index = -1;
            var i = 0;
            while (i < len(LANTERNS))
            {
                var l = LANTERNS[i];
                if (dist2(POINTER_X, POINTER_Y, l[0], l[1]) <= (19 * 19))
                {
                    near_index = i;
                    break;
                }
                i += 1;
            }

            if (near_index != -1)
            {
                clear_lantern_at(near_index);
            }
            else
            {
                var max_allowed = len(TARGETS) + MAX_EXTRA_LANTERNS;
                if (len(LANTERNS) < max_allowed)
                {
                    LANTERNS.push([POINTER_X, POINTER_Y]);
                }
            }
        }
    }

    if (level_is_solved())
    {
        if (!LEVEL_SOLVED)
        {
            LEVEL_SOLVED = true;
            LEVEL_SOLVE_TIMER = 0.0;
        }

        LEVEL_SOLVE_TIMER += _dt;
        if (LEVEL_SOLVE_TIMER >= 1.05)
        {
            if (CURRENT_LEVEL < TOTAL_LEVELS)
            {
                CURRENT_LEVEL += 1;
                build_level(CURRENT_LEVEL);
            }
            else
            {
                SESSION_SECONDS = time() - SESSION_START_TIME;
                WIN_INDEX = 0;
                GAME_STATE = STATE_WIN;
            }
        }
    }
    else
    {
        LEVEL_SOLVED = false;
        LEVEL_SOLVE_TIMER = 0.0;
    }
}

def do_pause_action(_idx)
{
    if (_idx == 0)
    {
        GAME_STATE = STATE_PLAY;
    }
    elif (_idx == 1)
    {
        restart_level();
        GAME_STATE = STATE_PLAY;
    }
    else
    {
        GAME_STATE = STATE_MENU;
    }
}

def update_pause()
{
    if (key_pressed(KEY_ESCAPE) || key_pressed(KEY_P) || key_pressed(KEY_SPACE))
    {
        GAME_STATE = STATE_PLAY;
        return;
    }

    if (key_pressed(KEY_UP))
    {
        PAUSE_INDEX -= 1;
        if (PAUSE_INDEX < 0) PAUSE_INDEX = len(PAUSE_OPTIONS) - 1;
    }

    if (key_pressed(KEY_DOWN))
    {
        PAUSE_INDEX += 1;
        if (PAUSE_INDEX >= len(PAUSE_OPTIONS)) PAUSE_INDEX = 0;
    }

    var bx = VIEW_W / 2 - 190;
    var by0 = VIEW_H / 2 - 22;
    var bw = 380;
    var bh = 44;
    var gap = 12;

    var i = 0;
    while (i < len(PAUSE_OPTIONS))
    {
        var by = by0 + i * (bh + gap);
        if (point_in_rect(POINTER_X, POINTER_Y, bx, by, bw, bh))
        {
            PAUSE_INDEX = i;
            if (POINTER_PRESSED)
            {
                do_pause_action(PAUSE_INDEX);
                return;
            }
        }
        i += 1;
    }

    if (key_pressed(KEY_ENTER))
    {
        do_pause_action(PAUSE_INDEX);
    }
}

def do_win_action(_idx)
{
    if (_idx == 0)
    {
        start_session();
    }
    else
    {
        GAME_STATE = STATE_MENU;
    }
}

def update_win()
{
    if (key_pressed(KEY_UP) || key_pressed(KEY_LEFT))
    {
        WIN_INDEX -= 1;
        if (WIN_INDEX < 0) WIN_INDEX = len(WIN_OPTIONS) - 1;
    }

    if (key_pressed(KEY_DOWN) || key_pressed(KEY_RIGHT))
    {
        WIN_INDEX += 1;
        if (WIN_INDEX >= len(WIN_OPTIONS)) WIN_INDEX = 0;
    }

    var bx = VIEW_W / 2 - 190;
    var by0 = VIEW_H / 2 + 110;
    var bw = 380;
    var bh = 48;
    var gap = 14;

    var i = 0;
    while (i < len(WIN_OPTIONS))
    {
        var by = by0 + i * (bh + gap);
        if (point_in_rect(POINTER_X, POINTER_Y, bx, by, bw, bh))
        {
            WIN_INDEX = i;
            if (POINTER_PRESSED)
            {
                do_win_action(WIN_INDEX);
                return;
            }
        }
        i += 1;
    }

    if (key_pressed(KEY_ENTER) || key_pressed(KEY_SPACE))
    {
        do_win_action(WIN_INDEX);
    }

    if (key_pressed(KEY_ESCAPE))
    {
        GAME_STATE = STATE_MENU;
    }
}

// ----------------------------------------------------------
// Drawing: gameplay layer
// ----------------------------------------------------------
def draw_targets_and_lanterns()
{
    var i = 0;
    while (i < len(TARGETS))
    {
        var t = TARGETS[i];
        var tx = t[0];
        var ty = t[1];

        var ry = reflection_y(ty);
        var matched = (target_match_index(i) >= 0);

        if (matched)
        {
            set_color(106, 216, 174);
        }
        else
        {
            set_color(255, 226, 136);
        }

        // Star marker above water
        draw_circle(tx, ty, TARGET_RADIUS, true);
        draw_line(tx - 11, ty, tx + 11, ty);
        draw_line(tx, ty - 11, tx, ty + 11);

        // Reflection goal marker below water
        if (matched) set_color(76, 200, 162);
        else set_color(128, 160, 206);

        draw_circle(tx, ry, TARGET_RADIUS + 4, false);

        if (matched)
        {
            set_color(90, 198, 164);
            draw_line(tx, ty + 14, tx, ry - 14);
        }

        i += 1;
    }

    // Lanterns
    i = 0;
    while (i < len(LANTERNS))
    {
        var l = LANTERNS[i];
        var lx = l[0];
        var ly = l[1];

        // glow halo
        set_alpha(64);
        set_color(255, 184, 92);
        draw_circle(lx, ly, LANTERN_RADIUS + 11, true);

        set_alpha(255);
        set_color(255, 156, 66);
        draw_circle(lx, ly, LANTERN_RADIUS, true);

        set_color(255, 220, 160);
        draw_circle(lx, ly, 5, true);

        set_color(138, 84, 36);
        draw_circle(lx, ly, LANTERN_RADIUS, false);

        i += 1;
    }

    set_alpha(255);
}

def draw_play_hud()
{
    // top strip
    set_color(19, 30, 49);
    draw_rectangle(0, 0, VIEW_W, 78, true);

    set_color(236, 244, 255);
    draw_text("Lantern Reflection", 24, 20, 30);

    set_color(178, 198, 228);
    draw_text(format("Level {}/{}", CURRENT_LEVEL, TOTAL_LEVELS), 390, 30, 22);
    draw_text(format("Lanterns {}/{}", len(LANTERNS), len(TARGETS) + MAX_EXTRA_LANTERNS), 560, 30, 22);

    if (LEVEL_SOLVED)
    {
        set_color(132, 230, 174);
        draw_text("Perfect reflection!", 845, 30, 22);
    }
    else
    {
        set_color(166, 188, 220);
        draw_text("Place lanterns below to match reflections", 760, 30, 20);
    }

    // pause button
    var hot = point_in_rect(POINTER_X, POINTER_Y, BTN_PAUSE_X, BTN_PAUSE_Y, BTN_PAUSE_W, BTN_PAUSE_H);
    if (hot) set_color(76, 112, 170);
    else set_color(50, 76, 118);
    draw_rectangle(BTN_PAUSE_X, BTN_PAUSE_Y, BTN_PAUSE_W, BTN_PAUSE_H, true);

    if (hot) set_color(208, 228, 255);
    else set_color(160, 182, 214);
    draw_rectangle(BTN_PAUSE_X, BTN_PAUSE_Y, BTN_PAUSE_W, BTN_PAUSE_H, false);

    set_color(240, 246, 255);
    draw_text("PAUSE", BTN_PAUSE_X + 22, BTN_PAUSE_Y + 10, 20);

    // bottom hint
    set_color(152, 176, 210);
    draw_text("Tap/click: place lantern  |  tap lantern: remove  |  ESC/P/SPACE: pause", 24, VIEW_H - 36, 18);
}

// ----------------------------------------------------------
// Drawing: state screens
// ----------------------------------------------------------
def draw_menu()
{
    draw_background();
    draw_snow();

    set_color(240, 247, 255);
    draw_text("Cozy Winter Jam 2026", VIEW_W / 2 - 184, 88, 28);

    set_color(255, 232, 176);
    draw_text("Lantern Reflection", VIEW_W / 2 - 212, 130, 52);

    set_color(178, 198, 224);
    draw_text("A tiny cozy puzzle about winter light and mirrored calm.", VIEW_W / 2 - 246, 196, 22);

    var bx = VIEW_W / 2 - 210;
    var by0 = 320;
    var bw = 420;
    var bh = 50;
    var gap = 14;

    var i = 0;
    while (i < len(MENU_OPTIONS))
    {
        var by = by0 + i * (bh + gap);
        var hot = point_in_rect(POINTER_X, POINTER_Y, bx, by, bw, bh);
        draw_button(bx, by, bw, bh, MENU_OPTIONS[i], hot, i == MENU_INDEX);
        i += 1;
    }

    set_color(150, 174, 208);
    draw_text("Keyboard: UP/DOWN + ENTER", VIEW_W / 2 - 170, VIEW_H - 76, 18);
    draw_text("Mouse/Touch: tap buttons", VIEW_W / 2 - 154, VIEW_H - 50, 18);

    if (SHOW_HELP)
    {
        set_color(0, 0, 0);
        set_alpha(178);
        draw_rectangle(0, 0, VIEW_W, VIEW_H, true);
        set_alpha(255);

        var px = VIEW_W / 2 - 360;
        var py = VIEW_H / 2 - 210;
        var pw = 720;
        var ph = 420;

        set_color(28, 42, 68);
        draw_rectangle(px, py, pw, ph, true);
        set_color(185, 209, 240);
        draw_rectangle(px, py, pw, ph, false);

        set_color(239, 246, 255);
        draw_text("How To Play", px + 24, py + 20, 34);

        set_color(200, 218, 240);
        draw_text("1) Stars above water are the source lights.", px + 28, py + 84, 24);
        draw_text("2) Place lanterns below water at mirrored positions.", px + 28, py + 126, 24);
        draw_text("3) When all reflections match, next level starts.", px + 28, py + 168, 24);
        draw_text("4) You can remove a lantern by tapping it.", px + 28, py + 210, 24);

        set_color(164, 188, 220);
        draw_text("Reflection rule: same X, mirrored Y around the water line.", px + 28, py + 270, 21);

        set_color(140, 176, 224);
        draw_rectangle(px + 236, py + ph - 78, 248, 46, true);
        set_color(208, 230, 255);
        draw_rectangle(px + 236, py + ph - 78, 248, 46, false);
        set_color(240, 247, 255);
        draw_text("Tap anywhere to close", px + 256, py + ph - 66, 22);
    }
}

def draw_play()
{
    draw_background();
    draw_snow();
    draw_targets_and_lanterns();
    draw_play_hud();
}

def draw_pause()
{
    draw_play();

    set_color(0, 0, 0);
    set_alpha(170);
    draw_rectangle(0, 0, VIEW_W, VIEW_H, true);
    set_alpha(255);

    var px = VIEW_W / 2 - 240;
    var py = VIEW_H / 2 - 170;
    var pw = 480;
    var ph = 320;

    set_color(28, 40, 62);
    draw_rectangle(px, py, pw, ph, true);
    set_color(176, 202, 236);
    draw_rectangle(px, py, pw, ph, false);

    set_color(238, 245, 255);
    draw_text("Paused", px + 178, py + 26, 42);

    var bx = VIEW_W / 2 - 190;
    var by0 = VIEW_H / 2 - 22;
    var bw = 380;
    var bh = 44;
    var gap = 12;

    var i = 0;
    while (i < len(PAUSE_OPTIONS))
    {
        var by = by0 + i * (bh + gap);
        var hot = point_in_rect(POINTER_X, POINTER_Y, bx, by, bw, bh);
        draw_button(bx, by, bw, bh, PAUSE_OPTIONS[i], hot, i == PAUSE_INDEX);
        i += 1;
    }

    set_color(166, 188, 218);
    draw_text("ESC / P / SPACE: resume", px + 118, py + ph - 34, 20);
}

def draw_win()
{
    draw_background();
    draw_snow();

    set_color(0, 0, 0);
    set_alpha(96);
    draw_rectangle(0, 0, VIEW_W, VIEW_H, true);
    set_alpha(255);

    var px = VIEW_W / 2 - 320;
    var py = VIEW_H / 2 - 240;
    var pw = 640;
    var ph = 500;

    set_color(24, 40, 66);
    draw_rectangle(px, py, pw, ph, true);
    set_color(182, 210, 242);
    draw_rectangle(px, py, pw, ph, false);

    set_color(255, 234, 172);
    draw_text("All reflections aligned", px + 76, py + 42, 46);

    var secs = int(SESSION_SECONDS);

    set_color(220, 234, 252);
    draw_text(format("You completed {} cozy levels.", TOTAL_LEVELS), px + 150, py + 140, 28);
    draw_text(format("Session time: {}s", secs), px + 206, py + 178, 28);

    set_color(168, 194, 226);
    draw_text("Thanks for playing this tiny winter jam game", px + 108, py + 236, 22);

    var bx = VIEW_W / 2 - 190;
    var by0 = VIEW_H / 2 + 110;
    var bw = 380;
    var bh = 48;
    var gap = 14;

    var i = 0;
    while (i < len(WIN_OPTIONS))
    {
        var by = by0 + i * (bh + gap);
        var hot = point_in_rect(POINTER_X, POINTER_Y, bx, by, bw, bh);
        draw_button(bx, by, bw, bh, WIN_OPTIONS[i], hot, i == WIN_INDEX);
        i += 1;
    }

    set_color(158, 184, 216);
    draw_text("ENTER to confirm  |  ESC to menu", px + 168, py + ph - 34, 18);
}

// ----------------------------------------------------------
// Bootstrap
// ----------------------------------------------------------
set_window_size(VIEW_W, VIEW_H);
set_window_title("Lantern Reflection - Cozy Winter Jam 2026");
set_design_resolution(VIEW_W, VIEW_H);
set_virtual_screen_enabled(true);
set_screen_scale_mode(3);

seed_snow();

loop
{
    var dt = delta();

    update_pointer();
    update_snow(dt);

    if (GAME_STATE == STATE_MENU)
    {
        update_menu();
    }
    elif (GAME_STATE == STATE_PLAY)
    {
        update_play(dt);
    }
    elif (GAME_STATE == STATE_PAUSE)
    {
        update_pause();
    }
    else
    {
        update_win();
    }

    set_draw_screen(true);

    if (GAME_STATE == STATE_MENU)
    {
        draw_menu();
    }
    elif (GAME_STATE == STATE_PLAY)
    {
        draw_play();
    }
    elif (GAME_STATE == STATE_PAUSE)
    {
        draw_pause();
    }
    else
    {
        draw_win();
    }

    set_draw_screen(false);

    if (!APP_RUNNING)
    {
        let_me_alone();
        break;
    }

    frame;
}
